###############################################################################
# Weather Outliers — environment template
#
# Copy to .env for local development:   cp .env.example .env
# NEVER commit a real .env file. It is gitignored; keep it that way.
#
# Every variable below has a safe default EXCEPT DATABASE_URL, so the app boots
# with zero configuration once a database is reachable. No paid API key is
# required: with no LLM key set, the agent falls back to deterministic templates.
###############################################################################

# =============================================================================
# DATABASE (required)
# =============================================================================
# Local development (see docker-compose.yml):
DATABASE_URL=postgresql+psycopg://weather:weather@localhost:5432/weather_outliers
# On Railway, reference the Postgres service over PRIVATE networking instead:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
# Railway injects a postgresql:// URL; the app rewrites it to
# postgresql+psycopg:// automatically, so you can paste the reference verbatim.

# Connection pool (keep small — Railway Postgres has modest connection limits)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=1800

# =============================================================================
# APPLICATION
# =============================================================================
ENVIRONMENT=development          # development | production
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console               # console (human, local) | json (production)

# Comma-separated list of origins allowed to call the API from a browser.
# In production set this to your real frontend origin — not "*".
CORS_ALLOW_ORIGINS=http://localhost:3000

# Public base URL of the API, used in OpenAPI docs and provenance links.
PUBLIC_API_BASE_URL=http://localhost:8000

# =============================================================================
# WEATHER PROVIDER — Open-Meteo
# =============================================================================
# Licensing: the free tier is for NON-COMMERCIAL use and data is CC-BY-4.0.
# See docs/data-sources.md. Leave OPEN_METEO_API_KEY empty to use the free tier.
WEATHER_PROVIDER=open_meteo       # open_meteo | fixture (offline, for tests/demo)

# Optional paid commercial subscription key. When set, the client automatically
# switches to the customer-* endpoints. No code change required.
OPEN_METEO_API_KEY=

OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_CUSTOMER_ARCHIVE_URL=https://customer-archive-api.open-meteo.com/v1/archive
OPEN_METEO_CUSTOMER_FORECAST_URL=https://customer-api.open-meteo.com/v1/forecast

# Open-Meteo bills in WEIGHTED API calls, not HTTP requests:
#   weight = max(1, (variables / 10) * (days / 14))
# One 10-year chunk of 5 daily variables is a single HTTP request but ~130 calls.
# The published free-tier allowances are 600/minute, 5,000/hour and 10,000/day;
# these defaults keep 15-20% headroom because the weight is our estimate of the
# provider's accounting, not a reading of it. See docs/data-sources.md.
PROVIDER_MAX_CALL_WEIGHT_PER_MINUTE=500
PROVIDER_MAX_CALL_WEIGHT_PER_HOUR=4200
PROVIDER_MAX_CALL_WEIGHT_PER_DAY=8500
# Longest the client will block waiting for a quota window to reopen. Beyond this
# it raises ProviderBudgetExhausted so `build-baselines` stops cleanly and can be
# rerun later instead of sleeping for an hour.
PROVIDER_MAX_BUDGET_WAIT_SECONDS=180
PROVIDER_REQUEST_TIMEOUT_SECONDS=60
PROVIDER_MAX_RETRIES=3
PROVIDER_BACKOFF_BASE_SECONDS=2.0
# Cities per multi-location archive request when building baselines.
PROVIDER_BASELINE_BATCH_SIZE=1

# =============================================================================
# BASELINE CLIMATOLOGY
# =============================================================================
BASELINE_START_YEAR=1991
BASELINE_END_YEAR=2020
# Seasonal window: +/- N calendar days around the target day-of-year.
BASELINE_SEASONAL_WINDOW_DAYS=7
# Minimum usable samples in the seasonal window before a baseline is considered
# sufficient. 30 years x 15 days = 450 potential samples.
BASELINE_MIN_SAMPLES=120
# Minimum non-zero wet days required before precipitation extremes are ranked.
BASELINE_MIN_WET_DAYS=15

# =============================================================================
# ANOMALY DETECTION + RANKING
# =============================================================================
RANKING_TOP_N=10
# Default true: one event per city in the published top 10 (all events are still
# stored and queryable). Prevents a single heat dome city from owning the board.
RANKING_ONE_EVENT_PER_CITY=true
# Allow provisional (near-real-time model) data into published rankings.
# Required for "yesterday" coverage because the ERA5 archive lags ~5 days.
# Provisional runs are clearly labelled and are superseded by `finalize`.
ALLOW_PROVISIONAL_IN_RANKINGS=true
# Minimum score for an event to be publishable at all.
RANKING_MIN_SCORE=0.5

# =============================================================================
# AI INVESTIGATION AGENT
# =============================================================================
# none      -> deterministic template explanations (no API key, no cost)
# anthropic -> Claude via the Anthropic Messages API
# openai    -> any OpenAI-compatible chat-completions endpoint
LLM_PROVIDER=none

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_API_VERSION=2023-06-01

# The `openai` provider speaks plain Chat Completions, so it drives any
# compatible endpoint — OpenAI itself, DeepSeek, or a self-hosted gateway. For
# DeepSeek: OPENAI_BASE_URL=https://api.deepseek.com/v1, a DeepSeek model name,
# and OPENAI_MAX_TOKENS_PARAM=max_tokens.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Deliberately empty: naming a default model would be inventing a choice for an
# endpoint we have not tested. Required when LLM_PROVIDER=openai.
OPENAI_MODEL=
# Which field carries the output cap: `max_completion_tokens` (OpenAI's current
# name; its reasoning models reject the old one) or `max_tokens` (DeepSeek and
# most other compatible gateways). No single name works on both, and sending
# both is rejected by the strict endpoints. Set it wrong on a lenient endpoint
# and there is no error — the cap is simply ignored, which is why it is explicit.
OPENAI_MAX_TOKENS_PARAM=max_completion_tokens

# Hard bounds per investigated event (cost + latency control)
AGENT_MAX_TOOL_CALLS=6
AGENT_MAX_ITERATIONS=5
AGENT_TIMEOUT_SECONDS=45
AGENT_MAX_RETRIES=2
AGENT_MAX_OUTPUT_TOKENS=1200
# Only investigate the top N ranked events with the LLM. The rest get templates.
AGENT_INVESTIGATE_TOP_N=10

# Monthly spend ceiling in USD. When the recorded month-to-date estimated spend
# reaches this value, the agent stops calling the LLM and uses templates for the
# remainder of the month. Set to 0 to disable LLM calls entirely.
AGENT_MONTHLY_USD_BUDGET=5.00
# Per-million-token prices used ONLY for budget accounting, and zero by default
# because this project will not invent a number it has not verified: leaving them
# at 0 means the USD ceiling cannot bind, so the call ceiling below is the real
# limit. Set both to your provider's current published prices to enable the
# dollar budget.
AGENT_USD_PER_MTOK_INPUT=0.0
AGENT_USD_PER_MTOK_OUTPUT=0.0
# A provider-agnostic backstop that works even when prices are unknown: the
# absolute number of LLM requests allowed in a calendar month. 50 cities x ~10
# investigated events x ~31 days is well under this.
AGENT_MONTHLY_MAX_LLM_CALLS=2000

# =============================================================================
# API RATE LIMITING (public read-only API)
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_BURST=30
# Trust X-Forwarded-For for client identity. Enable behind Railway's proxy only.
RATE_LIMIT_TRUST_FORWARDED_FOR=true
# Cache-Control max-age for published, immutable ranking payloads.
HTTP_CACHE_SECONDS=300

# Bound expensive queries.
MAX_PAGE_SIZE=200
MAX_HISTORY_DAYS=400

# =============================================================================
# PIPELINE SCHEDULING
# =============================================================================
# The worker only analyses local dates that finished at least this many hours
# ago, giving the upstream provider time to publish the completed day.
PIPELINE_SOURCE_LAG_HOURS=6
# Lag after which ERA5 archive data is expected to exist, enabling `finalize`.
PIPELINE_FINALIZE_LAG_DAYS=6
# Fail the run if fewer than this fraction of cities returned usable data.
PIPELINE_MIN_CITY_COMPLETENESS=0.80

# =============================================================================
# OBSERVABILITY — MLflow (optional)
# =============================================================================
# Tracing is off unless this is true, and a missing MLflow client is not an error:
# `app.observability.tracing` degrades to no-ops either way, so telemetry can never
# take the pipeline down with it.
MLFLOW_TRACING_ENABLED=false

# Where traces and evaluation runs are stored.
#   Local:   sqlite:////absolute/path/to/weather-outliers/mlflow.db
#            Note the four slashes, and note the scheme: MLflow 3 rejects bare
#            `file:` tracking URIs outright.
#   Railway: http://mlflow.railway.internal:5000
#            The private MLflow service in ops/mlflow. Private network only — it
#            has no public domain, because MLflow has no authentication of its own.
MLFLOW_TRACKING_URI=

# Experiment for pipeline traces. Evaluation runs go to MLFLOW_EVAL_EXPERIMENT,
# which defaults to this name with "-evals" appended so that an evaluation against
# synthetic fixtures is never mistaken for a real run over real weather.
MLFLOW_EXPERIMENT=weather-outliers
MLFLOW_EVAL_EXPERIMENT=

# Credentials for a tracking server that has HTTP basic auth enabled. MLflow's own
# client reads these from the process environment, so for local runs `export` them
# rather than relying on this file, which only pydantic-settings reads.
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=

# ---------------------------------------------------------------------------
# For the tracking SERVER service only (ops/mlflow). The application never reads
# these; they are listed here so the whole configuration lives in one place.
# ---------------------------------------------------------------------------
# A database reserved for MLflow. Not the application's: MLflow runs its own
# migrations, and sharing the database means two migration histories in one schema.
# On Railway this is a second Postgres service — named `mlflow-db` in the deployment
# this file documents, because a service called `mlflow` would claim
# mlflow.railway.internal, which the tracking server needs. Reference it rather than
# copying the password out of it:
#   MLFLOW_BACKEND_STORE_URI=${{mlflow-db.DATABASE_URL}}
# Artifact directory. Must be on a mounted volume or artifacts vanish on deploy.
#   MLFLOW_ARTIFACTS_DESTINATION=/data/mlartifacts
# The port the server binds. Railway injects PORT for services with a domain; this
# one has none, so it is set explicitly and the clients' URI must agree with it.
#   PORT=5000
# Basic auth. Set both, or set MLFLOW_ALLOW_ANONYMOUS=true and attach no domain;
# the entrypoint refuses to start a server that has neither.
#   MLFLOW_AUTH_USERNAME=
#   MLFLOW_AUTH_PASSWORD=
#   MLFLOW_ALLOW_ANONYMOUS=false
# Host header allowlist. The default already covers *.railway.internal and
# localhost. Override only when adding a domain.
#   MLFLOW_ALLOWED_HOSTS=

# =============================================================================
# EVALUATION — optional model-based judge (costs money; off by default)
# =============================================================================
# Only read by `python -m evals.runner --judge`. The deterministic evaluators need
# none of this, and no evaluation reaches a paid model without the flag.
EVAL_JUDGE_PROVIDER=anthropic
EVAL_JUDGE_MODEL=

# =============================================================================
# EVALUATION DELIVERY — email the summary (read by `python -m evals.deliver`)
# =============================================================================
# Generic SMTP. Leave SMTP_HOST empty and no email is sent; the evaluation worker
# then only persists the report to DATABASE_URL. The application itself never
# sends email — these are read by the evaluation delivery worker alone.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Send the summary here (one address).
EVAL_EMAIL_TO=
# Whether to use STARTTLS after connecting (port 587 wants this).
SMTP_TLS=true

# =============================================================================
# CHAT — natural language to SQL (opt-in; costs money per question)
# =============================================================================
# The NL→SQL endpoint (POST /api/chat) turns a question into a read-only SELECT
# over the application database and returns the rows plus the SQL it ran. It calls
# a language model per question, so it is OFF by default. Requires LLM_PROVIDER,
# an API key, and a model name (see the AI INVESTIGATION AGENT section above).
CHAT_ENABLED=false
# Optional shared secret. When set, POST /api/chat requires a matching
# `X-API-Key` header. Set this in production: a public, unauthenticated chat
# endpoint is a public budget.
CHAT_API_KEY=
# Hard cap on rows the generated SQL may return, enforced by the executor.
CHAT_MAX_ROWS=100

# =============================================================================
# FRONTEND (Next.js)
# =============================================================================
# Server-side base URL the Next.js server uses to reach FastAPI.
# On Railway use the PRIVATE network address (no public egress, no TLS needed):
#   API_BASE_URL=http://backend.railway.internal:8000
API_BASE_URL=http://localhost:8000

# Optional. Only set if the browser must call the API directly. Leave EMPTY to
# keep all API traffic server-side, which is the default and preferred setup.
NEXT_PUBLIC_API_BASE_URL=

# Map tiles. OpenFreeMap serves OpenStreetMap-derived vector tiles with no API
# key. Attribution is rendered in the UI. See docs/data-sources.md.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

NEXT_PUBLIC_SITE_NAME=Weather Outliers
NEXT_PUBLIC_SITE_URL=http://localhost:3000
